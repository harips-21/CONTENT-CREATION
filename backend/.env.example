# AI Content Studio - Backend Environment Example
PORT=5000
JWT_SECRET="ai-content-studio-super-secret-jwt-key-2026"
DATABASE_URL="file:./dev.db"

# AI Provider Configuration
# Set GEMINI_API_KEY to enable real Google Gemini API generation.
# If left empty, the application automatically defaults to Demo Mode (MockAIProvider).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
AI_PROVIDER="gemini"
